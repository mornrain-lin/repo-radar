# Dependencies
node_modules/
.pnp
.pnp.js

# Secrets — this is the single most important block in this file.
# A GitHub token in git history is compromised forever, even after a force push:
# forks and caches keep it alive. Never commit one; rotate immediately if you do.
.env
.env.*
!.env.example
*.pem
*.key
secrets.json

